{
  "name": "poe2-filter-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test src/lib/*.test.ts",
    "data:import-affixes": "tsx scripts/import-affixes.ts",
    "data:build-affixes": "tsx scripts/import-affixes.ts --offline",
    "data:build-crafting": "tsx scripts/build-crafting-data.ts",
    "data:sync-crafting-icons": "tsx scripts/sync-crafting-icons.ts",
    "data:sync-crafting-bases": "tsx scripts/sync-crafting-bases.ts",
    "data:sync-crafting-item-text": "python scripts/sync-crafting-item-text.py",
    "data:sync-crafting-names": "python scripts/sync-crafting-names.py",
    "data:build-crafting-traditional": "tsx scripts/build-crafting-traditional.ts",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build --no-bundle"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "opencc-js": "^1.4.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.25.0"
}
